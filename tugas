class Produk {
    // Encapsulation (private)
    private String nama;
    private double harga;
    private int stok;

    // Constructor 1 (overloading)
    public Produk(String nama) {
        this.nama = nama;
        this.harga = 0;
        this.stok = 0;
    }

    // Constructor 2 (overloading)
    public Produk(String nama, double harga, int stok) {
        this.nama = nama;
        setHarga(harga); // pakai setter biar tervalidasi
        setStok(stok);
    }

    // Getter
    public String getNama() {
        return nama;
    }

    public double getHarga() {
        return harga;
    }

    public int getStok() {
        return stok;
    }

    // Setter (dengan validasi)
    public void setHarga(double harga) {
        if (harga > 0) {
            this.harga = harga;
        } else {
            System.out.println("Harga tidak boleh negatif!");
        }
    }

    public void setStok(int stok) {
        if (stok >= 0) {
            this.stok = stok;
        } else {
            System.out.println("Stok tidak boleh negatif!");
        }
    }

    // Method tampil data
    public void tampilkanProduk() {
        System.out.println("Nama  : " + nama);
        System.out.println("Harga : " + harga);
        System.out.println("Stok  : " + stok);
    }
}

public class Main {
    public static void main(String[] args) {

        // Object dengan constructor sederhana
        Produk p1 = new Produk("Laptop");

        // Set nilai pakai setter
        p1.setHarga(8000000);
        p1.setStok(10);

        System.out.println("=== Produk 1 ===");
        p1.tampilkanProduk();

        System.out.println("--------------------");

        // Object dengan constructor lengkap
        Produk p2 = new Produk("HP", 3000000, 5);

        System.out.println("=== Produk 2 ===");
        p2.tampilkanProduk();

        System.out.println("--------------------");

        // Contoh validasi (error)
        p2.setHarga(-5000);
        p2.setStok(-2);
    }
}
